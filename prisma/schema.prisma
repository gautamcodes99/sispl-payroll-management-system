generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id Int @id @default(autoincrement())

  // Personal Information
  photo String?

  firstName  String
  lastName   String
  fatherName String?

  dateOfBirth DateTime?
  gender      String?

  email String? @unique
  phone String?

  // Employment
  designationId Int
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Restrict)

  joiningDate DateTime
  basicSalary Decimal
  status      String   @default("ACTIVE")

  leftReason String?
  leftDate   DateTime?

  // Address
  presentAddress   String?
  permanentAddress String?

  // Bank Details
  bankName          String?
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?

  // Statutory Details
  aadhaarNumber String?
  panNumber     String?
  uanNumber     String?
  esicNumber    String?

  // Nominee
  nomineeName         String?
  nomineeRelationship String?
  nomineeMobile       String?

  // Relations
  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id Int @id @default(autoincrement())

  siteName String

  address       String?
  city          String?
  state         String?
  pinCode       String?
  contactPerson String?
  contactNumber String?

  status String @default("ACTIVE")

  workTypes    WorkType[]
  designations Designation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkType {
  id Int @id @default(autoincrement())

  siteId Int
  site   Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  workTypeName String
  status       String @default("ACTIVE")

  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, workTypeName])
}

model Department {
  id Int @id @default(autoincrement())

  workTypeId Int
  workType   WorkType @relation(fields: [workTypeId], references: [id], onDelete: Cascade)

  departmentName String
  status         String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workTypeId, departmentName])
}

model Designation {
  id Int @id @default(autoincrement())

  siteId Int
  site   Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  designationName String

  status String @default("ACTIVE")

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, designationName])
}

model Attendance {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  attendanceDate DateTime
  status         AttendanceStatus

  otHours Decimal @default(0) @db.Decimal(5, 2)
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, attendanceDate])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
  WEEKLY_OFF
}
