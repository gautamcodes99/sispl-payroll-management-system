generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                  Int       @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String?   @unique
  phone               String?
  joiningDate         DateTime
  basicSalary         Decimal
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  designationId       Int
  aadhaarNumber       String?
  accountHolderName   String?
  accountNumber       String?
  bankName            String?
  dateOfBirth         DateTime?
  esicNumber          String?
  fatherName          String?
  gender              String?
  ifscCode            String?
  nomineeMobile       String?
  nomineeName         String?
  nomineeRelationship String?
  panNumber           String?
  permanentAddress    String?
  photo               String?
  presentAddress      String?
  uanNumber           String?
  leftDate            DateTime?
  leftReason          String?

  attendances        Attendance[]
  designation        Designation               @relation(fields: [designationId], references: [id])
  variableAllowances VariableAllowance[]
  manualDeductions   ManualDeduction[]
  payrollSnapshots   PayrollEmployeeSnapshot[]
}

model Site {
  id            Int        @id @default(autoincrement())
  siteName      String
  address       String?
  city          String?
  state         String?
  pinCode       String?
  contactPerson String?
  contactNumber String?
  status        String     @default("ACTIVE")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  workTypes     WorkType[]
}

model WorkType {
  id           Int          @id @default(autoincrement())
  siteId       Int
  workTypeName String
  status       String       @default("ACTIVE")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  departments  Department[]
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, workTypeName])
}

model Department {
  id             Int          @id @default(autoincrement())
  workTypeId     Int
  departmentName String
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  workType       WorkType     @relation(fields: [workTypeId], references: [id], onDelete: Cascade)
  attendances    Attendance[]

  @@unique([workTypeId, departmentName])
}

model Designation {
  id              Int      @id @default(autoincrement())
  designationName String   @unique
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employees   Employee[]
  wageMasters WageMaster[]
}

model Attendance {
  id             Int              @id @default(autoincrement())
  employeeId     Int
  departmentId   Int?
  attendanceDate DateTime
  otHours        Decimal          @default(0) @db.Decimal(5, 2)
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  status         AttendanceStatus
  shift          AttendanceShift

  employee   Employee    @relation(fields: [employeeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([employeeId, attendanceDate, shift])
  @@index([departmentId])
}

model WageMaster {
  id            Int                @id @default(autoincrement())
  designationId Int
  version       Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  basic         Decimal            @db.Decimal(12, 2)
  da            Decimal            @db.Decimal(12, 2)
  hraPercentage Decimal            @default(5.00) @db.Decimal(5, 2)
  otOption      WageMasterOtOption @default(OPTION_A)
  status        WageMasterStatus   @default(DRAFT)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  designation       Designation               @relation(fields: [designationId], references: [id], onDelete: Restrict)
  specialAllowances SpecialAllowanceSlab[]
  payrollSnapshots  PayrollEmployeeSnapshot[]

  @@unique([designationId, version])
  @@index([designationId, effectiveFrom])
}

model SpecialAllowanceSlab {
  id           Int      @id @default(autoincrement())
  wageMasterId Int
  minDays      Decimal  @db.Decimal(5, 1)
  maxDays      Decimal  @db.Decimal(5, 1)
  ratePerDay   Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wageMaster WageMaster @relation(fields: [wageMasterId], references: [id], onDelete: Cascade)

  @@unique([wageMasterId, minDays, maxDays])
  @@index([wageMasterId])
}

model VariableAllowance {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  salaryMonth DateTime
  conveyance  Decimal  @default(0) @db.Decimal(12, 2)
  arrears     Decimal  @default(0) @db.Decimal(12, 2)
  rab         Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, salaryMonth])
  @@index([salaryMonth])
  @@index([employeeId])
}

model ManualDeduction {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  salaryMonth     DateTime
  advanceRecovery Decimal  @default(0) @db.Decimal(12, 2)
  canteen         Decimal  @default(0) @db.Decimal(12, 2)
  transport       Decimal  @default(0) @db.Decimal(12, 2)
  uniformRecovery Decimal  @default(0) @db.Decimal(12, 2)
  fine            Decimal  @default(0) @db.Decimal(12, 2)
  otherDeduction  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, salaryMonth])
  @@index([salaryMonth])
  @@index([employeeId])
}

// =========================================================
// PAYROLL RUN
//
// Represents one finalized/reprocessed company payroll
// for one salary month.
//
// Preview is NOT stored here.
// Preview remains calculation-only.
//
// Reprocessing creates a newer version.
// Historical versions are preserved.
// =========================================================

model PayrollRun {
  id          Int              @id @default(autoincrement())
  salaryMonth DateTime
  version     Int
  status      PayrollRunStatus
  finalizedAt DateTime?
  unlockedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  snapshots PayrollEmployeeSnapshot[]

  @@unique([salaryMonth, version])
  @@index([salaryMonth, status])
}

// =========================================================
// PAYROLL EMPLOYEE SNAPSHOT
//
// Stores the finalized payroll result for one employee.
//
// Historical values are copied into this record so reports
// do not depend on future changes to Employee, Designation,
// Wage Master, Attendance, Allowances or Deductions.
//
// Site fields are nullable because Site is operational
// attendance context, not a property of Designation.
//
// Existing historical snapshots may retain their old Site
// values. Future payroll snapshots must not fabricate a Site
// from Designation.
//
// Money is persisted at 2 decimal places.
// Payroll calculation itself may use full precision before
// final snapshot values are created.
// =========================================================

model PayrollEmployeeSnapshot {
  id           Int @id @default(autoincrement())
  payrollRunId Int
  employeeId   Int
  wageMasterId Int

  // ---------------------------------------------------------
  // EMPLOYEE / ORGANISATION SNAPSHOT
  // ---------------------------------------------------------

  employeeName    String
  gender          String?
  designationId   Int
  designationName String
  siteId          Int?
  siteName        String?

  bankName          String?
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?
  uanNumber         String?
  esicNumber        String?

  // ---------------------------------------------------------
  // WAGE MASTER SNAPSHOT
  // ---------------------------------------------------------

  wageMasterVersion Int

  // ---------------------------------------------------------
  // ATTENDANCE SNAPSHOT
  // ---------------------------------------------------------

  presentDays  Decimal @db.Decimal(5, 1)
  halfDays     Decimal @db.Decimal(5, 1)
  paidHolidays Decimal @db.Decimal(5, 1)
  payableDays  Decimal @db.Decimal(5, 1)
  otHours      Decimal @db.Decimal(8, 2)

  // ---------------------------------------------------------
  // WAGE VALUES
  // ---------------------------------------------------------

  monthlyBasic Decimal @db.Decimal(14, 2)
  monthlyDa    Decimal @db.Decimal(14, 2)

  earnedBasic Decimal @db.Decimal(14, 2)
  earnedDa    Decimal @db.Decimal(14, 2)
  wages       Decimal @db.Decimal(14, 2)

  hraPercentage Decimal @db.Decimal(5, 2)
  hra           Decimal @db.Decimal(14, 2)

  otRate   Decimal @db.Decimal(14, 2)
  otAmount Decimal @db.Decimal(14, 2)

  conveyance Decimal @db.Decimal(14, 2)

  // ---------------------------------------------------------
  // SPECIAL ALLOWANCE SNAPSHOT
  //
  // Slab fields are nullable because an employee may have
  // payable days outside every configured slab.
  // ---------------------------------------------------------

  specialAllowanceRate    Decimal? @db.Decimal(14, 2)
  specialAllowanceMinDays Decimal? @db.Decimal(5, 1)
  specialAllowanceMaxDays Decimal? @db.Decimal(5, 1)
  specialAllowanceAmount  Decimal  @db.Decimal(14, 2)

  rab     Decimal @db.Decimal(14, 2)
  arrears Decimal @db.Decimal(14, 2)

  gross Decimal @db.Decimal(14, 2)

  // ---------------------------------------------------------
  // STATUTORY DEDUCTIONS
  // ---------------------------------------------------------

  pf   Decimal @db.Decimal(14, 2)
  esic Decimal @db.Decimal(14, 2)
  ptax Decimal @db.Decimal(14, 2)
  mlwf Decimal @db.Decimal(14, 2)

  statutoryDeductionTotal Decimal @db.Decimal(14, 2)

  // ---------------------------------------------------------
  // MANUAL DEDUCTIONS
  // ---------------------------------------------------------

  advanceRecovery Decimal @db.Decimal(14, 2)
  canteen         Decimal @db.Decimal(14, 2)
  transport       Decimal @db.Decimal(14, 2)
  uniformRecovery Decimal @db.Decimal(14, 2)
  fine            Decimal @db.Decimal(14, 2)
  otherDeduction  Decimal @db.Decimal(14, 2)

  manualDeductionTotal Decimal @db.Decimal(14, 2)

  // ---------------------------------------------------------
  // FINAL TOTALS
  // ---------------------------------------------------------

  totalDeductions Decimal @db.Decimal(14, 2)
  netSalary       Decimal @db.Decimal(14, 2)

  // ---------------------------------------------------------
  // WARNINGS
  //
  // Example:
  // ["Net salary is negative."]
  // ---------------------------------------------------------

  warnings Json?

  createdAt DateTime @default(now())

  // ---------------------------------------------------------
  // RELATIONS
  // ---------------------------------------------------------

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  wageMaster WageMaster @relation(fields: [wageMasterId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@index([wageMasterId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
  WEEKLY_OFF
  HALF_DAY
  PAID_HOLIDAY
}

enum AttendanceShift {
  FIRST
  SECOND
  THIRD
}

enum WageMasterOtOption {
  OPTION_A
}

enum WageMasterStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

// =========================================================
// PAYROLL RUN STATUS
//
// FINALIZED  = payroll finalized and month locked
// UNLOCKED   = corrections permitted before reprocessing
// SUPERSEDED = older finalized version replaced by a newer
//              reprocessed version; history remains intact
// =========================================================

enum PayrollRunStatus {
  FINALIZED
  UNLOCKED
  SUPERSEDED
}
